<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.portalfiscal.inf.br/cte" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:ns1="http://www.portalfiscal.inf.br/cte" targetNamespace="http://www.portalfiscal.inf.br/cte" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="eventoCTeTiposBasico_v4.00.xsd"/>
	<xs:element name="evCTeSubcontratacao">
		<xs:annotation>
			<xs:documentation>Schema XML de validação do evento de marcação Autorizado Subcontratação 440150</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="descEvento">
					<xs:annotation>
						<xs:documentation>Descrição do Evento - “Autorizado Subcontratação”</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:whiteSpace value="preserve"/>
							<xs:enumeration value="Autorizado Subcontratação"/>
							<xs:enumeration value="Autorizado Subcontratacao"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="chCTeSubcon" type="TChDFe">
					<xs:annotation>
						<xs:documentation>Informar a chave de acesso do CT-e de Subcontratação que referenciou o CT-e</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="dhRecbto" type="TDateTimeUTC">
					<xs:annotation>
						<xs:documentation>Data e hora de processamento do CT-e de Subcontratação que referenciou o CT-e, no formato AAAA-MM-DDTHH:MM:SS TZD. </xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="nProt" type="TProt">
					<xs:annotation>
						<xs:documentation>Número do Protocolo de Autorização do CT-e de Subcontratação que referenciou o CT-e. </xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
