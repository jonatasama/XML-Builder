<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.portalfiscal.inf.br/nfe" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" targetNamespace="http://www.portalfiscal.inf.br/nfe" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="detEvento">
		<xs:annotation>
			<xs:documentation>Schema XML de validação do evento de CT-e autorizado</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="descEvento"/>
				<xs:element ref="CTe"/>
				<xs:element ref="emit"/>
			</xs:sequence>
			<xs:attribute name="versao" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:enumeration value="1.00"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="descEvento">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="CT-e Autorizado"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CTe">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="chCTe"/>
				<xs:element ref="modal"/>
				<xs:element ref="dhEmi"/>
				<xs:element ref="nProt"/>
				<xs:element ref="dhRecbto"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="emit">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="CNPJ"/>
				<xs:element ref="IE"/>
				<xs:element ref="xNome"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="chCTe">
		<xs:simpleType>
			<xs:annotation>
				<xs:documentation>Chave do Conhecimento de Transporte</xs:documentation>
			</xs:annotation>
			<xs:restriction base="xs:string">
				<xs:whiteSpace value="preserve"/>
				<xs:pattern value="[0-9]{44}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="modal">
		<xs:simpleType>
			<xs:annotation>
				<xs:documentation>01=Rodov. 02=Aéreo; 03=Aquav. 04=Ferrov. 05=Dutov. 06=Multimodal</xs:documentation>
			</xs:annotation>
			<xs:restriction base="xs:string">
				<xs:whiteSpace value="preserve"/>			
				<xs:enumeration value="01"/>
				<xs:enumeration value="02"/>
				<xs:enumeration value="03"/>
				<xs:enumeration value="04"/>
				<xs:enumeration value="05"/>
				<xs:enumeration value="06"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="dhEmi">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:whiteSpace value="preserve"/>
				<xs:pattern value="(((20(([02468][048])|([13579][26]))-02-29))|(20[0-9][0-9])-((((0[1-9])|(1[0-2]))-((0[1-9])|(1\d)|(2[0-8])))|((((0[13578])|(1[02]))-31)|(((0[1,3-9])|(1[0-2]))-(29|30)))))T(20|21|22|23|[0-1]\d):[0-5]\d:[0-5]\d"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="nProt">
		<xs:simpleType>
			<xs:annotation>
				<xs:documentation>Número do Protocolo</xs:documentation>
			</xs:annotation>
			<xs:restriction base="xs:string">
				<xs:whiteSpace value="preserve"/>
				<xs:pattern value="[0-9]{15}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="dhRecbto" type="xs:dateTime">
		<xs:annotation>
			<xs:documentation>Data e hora do autorização do CT-e, formato AAAA-MM-DDTHH:MM:SS</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="CNPJ">
		<xs:simpleType>
			<xs:annotation>
				<xs:documentation>CNPJ da Trasnportadora emitente do CT-e</xs:documentation>
			</xs:annotation>
			<xs:restriction base="xs:string">
				<xs:whiteSpace value="preserve"/>
				<xs:pattern value="[0-9]{14}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="IE">
		<xs:simpleType>
			<xs:annotation>
				<xs:documentation>Inscrição Estadual da transportadora do CT-e</xs:documentation>
			</xs:annotation>
			<xs:restriction base="xs:string">
				<xs:whiteSpace value="preserve"/>
				<xs:pattern value="[0-9]{2,14}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="xNome">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="60"/>
				<xs:minLength value="2"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>