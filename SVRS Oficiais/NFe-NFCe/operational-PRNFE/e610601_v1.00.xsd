<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.portalfiscal.inf.br/nfe" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" targetNamespace="http://www.portalfiscal.inf.br/nfe" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="detEvento">
		<xs:annotation>
			<xs:documentation>Schema XML de validação do evento de CT-e cancelado</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="descEvento"/>
				<xs:element ref="CTe"/>
			</xs:sequence>
			<xs:attribute name="versao" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:enumeration value="1.00"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="descEvento">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="CT-e Cancelado"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CTe">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="chCTe"/>
				<xs:element ref="nProtCanc"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="chCTe">
		<xs:simpleType>
			<xs:annotation>
				<xs:documentation>Chave do Conhecimento de Transporte</xs:documentation>
			</xs:annotation>
			<xs:restriction base="xs:string">
				<xs:whiteSpace value="preserve"/>
				<xs:pattern value="[0-9]{44}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="nProtCanc">
		<xs:simpleType>
			<xs:annotation>
				<xs:documentation>Número do Protocolo de Cancelamento do CT-e</xs:documentation>
			</xs:annotation>
			<xs:restriction base="xs:string">
				<xs:whiteSpace value="preserve"/>
				<xs:pattern value="[0-9]{15}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>
